{
  "id": "percussion-02-left-right",
  "name": "Left and Right",
  "wing": "percussion",
  "hint": "Drums are mirrors, but only on the head side. Find where to stand so the wave meets each head, not its shell.",
  "music": {
    "root": 2,
    "mode": "dorian",
    "bpm": 100,
    "timeSignature": 4,
    "mood": "reflective"
  },
  "overrides": [
    {
      "x": 0,
      "y": 6,
      "open": true,
      "group": "entry"
    },
    {
      "x": 6,
      "y": 9,
      "rot": 0
    },
    {
      "x": 9,
      "y": 4,
      "rot": 90
    }
  ],
  "layout": [
    "#############",
    "#...........#",
    "#.@.........#",
    "#...........#",
    "#...#####b.*#",
    "#...#.*.#...#",
    "D...#...#...D",
    "#...##.##...#",
    "#...........#",
    "#.h...t.....#",
    "#...........#",
    "#...........#",
    "#############"
  ],
  "solution": [
    {
      "at": [
        1,
        9
      ],
      "face": "right",
      "do": "fire",
      "why": "across the hat; the tom's head slants /, so a wave going right bounces up through the gap into the boxed fork"
    },
    {
      "at": [
        9,
        1
      ],
      "face": "down",
      "do": "fire",
      "why": "the bass drum's head slants \\, so a wave coming down bounces right into the far fork (from below it would bounce into the wall)"
    }
  ]
}
